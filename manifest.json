{
  "manifest_version": 2,
  "name": "Letterboxd Review Translator",
  "version": "1.12",
  "description": "Translate Letterboxd Reviews that not in your native language",
  "permissions": [
    "storage",
    "activeTab",
    "*://*.letterboxd.com/*",
    "https://api-free.deepl.com/*"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "persistent": false
  },
  "browser_action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "src/icons/icon.png",
      "48": "src/icons/icon.png",
      "128": "src/icons/icon.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.letterboxd.com/*"
      ],
      "js": [
        "src/content-loader.js"
      ]
    }
  ],
  "web_accessible_resources": [
    "src/content.js",
    "src/l-d/*.js"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "reviewtranslatorletterboxd@jashior.com"
    }
  }
}